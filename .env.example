# LLM Provider Configuration
# Choose which LLM provider to use: ollama, cloudflare, openai, anthropic, gemini, groq
LLM_PROVIDER=ollama

# ============================================================
# OLLAMA (Local, Free, No API Key Needed)
# ============================================================
OLLAMA_MODEL=qwen2:7b
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# CLOUDFLARE WORKERS AI (Fast, Cheap)
# ============================================================
# Your account ID — found in your gateway URL:
#   https://gateway.ai.cloudflare.com/v1/{ACCOUNT_ID}/...
CLOUDFLARE_ACCOUNT_ID=

# ── Option A: AI Gateway (recommended — matches your curl setup) ──────────
# This is the CF_AIG_TOKEN from your AI Gateway setup
# Header used: cf-aig-authorization: Bearer <token>
# Gateway URL: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}/workers-ai/v1
CLOUDFLARE_AIG_TOKEN=
CLOUDFLARE_GATEWAY_NAME=default

# ── Option B: Direct Workers AI API ──────────────────────────────────────
# Get token at: https://dash.cloudflare.com/profile/api-tokens
# (Only needed if NOT using AI Gateway)
CLOUDFLARE_API_TOKEN=

# Model to use (same for both modes)
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ============================================================
# OPENAI (Powerful, Popular)
# ============================================================
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# ANTHROPIC CLAUDE (Excellent Reasoning)
# ============================================================
# Get API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# GOOGLE GEMINI (Large Context, Fast)
# ============================================================
# Get API key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================================
# GROQ (Extremely Fast Inference)
# ============================================================
# Get API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# OPTIONAL: Web Search API Keys
# ============================================================
# Brave Search (better results than DuckDuckGo)
# Get key: https://brave.com/search/api
BRAVE_API_KEY=

# ============================================================
# EMBEDDINGS (for RAG memory)
# ============================================================
# Uses Ollama's nomic-embed-text by default (no config needed)
# Or use OpenAI embeddings:
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
